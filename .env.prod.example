# Configuration de la base de données PostgreSQL - Production
# Note: Use "postgres" in production Docker environment
POSTGRES_HOST=postgres
POSTGRES_DB=atelier_kaisla_prod
POSTGRES_USER=kaisla_admin
POSTGRES_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION_SECURE_PASSWORD

# Noms de domaine (à adapter selon le serveur)
# Seule source de vérité — les URLs complètes (CORS, NUXT_PUBLIC_API_URL) sont dérivées
# automatiquement dans docker-compose.prod.yml en https://${...}
# Serveur 1: api.lebowvsky.com / kaisla.lebowvsky.com / bokaisla.lebowvsky.com / pgadminkaisla.lebowvsky.com
# Serveur 2: api.atelierkaisla.com / atelierkaisla.com / bo.atelierkaisla.com / pgadmin.atelierkaisla.com
FRONTEND_DOMAIN=atelierkaisla.com
BACKOFFICE_DOMAIN=bo.atelierkaisla.com
API_DOMAIN=api.atelierkaisla.com
PGADMIN_DOMAIN=pgadmin.atelierkaisla.com

# Configuration Backend
NODE_ENV=production
PORT=4000

# Base de données (connexion interne Docker)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=atelier_kaisla_prod
DATABASE_USER=kaisla_admin
DATABASE_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION_SECURE_PASSWORD

# pgAdmin - PostgreSQL Management Tool
# URL: https://pgadmin.atelierkaisla.com
PGADMIN_EMAIL=admin@kaisla.local
PGADMIN_PASSWORD=CHANGEZ_MOI_SECURE_PASSWORD

# JWT Configuration
# CRITICAL: Generate a strong secret for production using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_STRONG_SECRET_HERE_USE_CRYPTO_RANDOM_BYTES
JWT_EXPIRATION=1h

# Admin credentials (used by seed:auth:prod to create the initial admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEZ_MOI_SECURE_PASSWORD
